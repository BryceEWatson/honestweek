{
  "identity": {
    "authorEmails": ["you@example.com"]
  },
  "week": {
    "startsOn": "monday",
    "timezone": "UTC"
  },
  "repos": [
    {
      "path": "/path/to/your/repo",
      "label": "your-project",
      "role": "featured"
    },
    {
      "path": "~/code/a-repo-you-contribute-to",
      "label": "a-shared-repo",
      "role": "reference"
    },
    {
      "path": "~/code/a-client-repo",
      "label": "a-private-project",
      "role": "display"
    }
  ],
  "redaction": {
    "codenames": [],
    "names": [],
    "terms": []
  },
  "curation": {
    "maxItems": 12,
    "automaticMinScore": 2,
    "retentionWeeks": 12,
    "automaticCarryWeeks": 2,
    "categoryCaps": {
      "prompts": 2,
      "ideas": 2,
      "techniques": 3,
      "decisions": 2,
      "reversals": 1,
      "nextSteps": 2
    }
  },
  "privacy": {
    "publicRenditions": {
      "enabled": true,
      "maxAutomaticChangedPercent": 20,
      "generalizationMappings": {},
      "neverPublicTerms": []
    }
  },
  "output": {
    "mode": "digest",
    "file": "honestweek.digest.md"
  },
  "voice": {
    "denyMeta": false
  }
}
