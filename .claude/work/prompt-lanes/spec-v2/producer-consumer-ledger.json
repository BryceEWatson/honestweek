{
  "version": 1,
  "entries": [
    {
      "id": "laneIdentityCarrier",
      "producer": "phase-1:R17",
      "consumers": ["phase-2:R8", "phase-3:R1"],
      "schema": { "factory": "createLaneIdentityCarrier()", "methods": ["register(record):void", "records():ReadonlyArray<IdentityRecord>"], "lifetime": "one-discovery-or-build", "legacyReturnsChanged": false },
      "privacy": "build-local; never rendered or archived",
      "validation": "register validates exact keys and same-ref/different-canonical collisions",
      "error": "throw D69 identity error before adapter return",
      "positiveControl": "phase-1:A57 five-origin carrier handoff",
      "negativeControl": "phase-1:A57 conflicting canonical registration",
      "sources": ["decisions.md:D73", "phase-1.md:R17", "phase-2.md:R8"],
      "status": "resolved"
    },
    {
      "id": "identityRecord",
      "producer": "phase-1:R17",
      "consumers": ["phase-2:R8", "phase-2:R30", "phase-3:R1"],
      "schema": { "exactKeys": ["ref", "refCanonical", "kind", "repoKey", "repo", "receipt", "text", "sectioned", "shapeKey", "shapeCanonical"], "ref": "lowercase-8-hex", "refCanonical": "kind+U+0000+sourceId+U+0000+index", "kind": ["turn", "idea", "handoff-next-step", "handoff-reversal"], "repoKey": "nonnegative-integer", "repo": "configured-label", "receipt": ["{sessionId:string,turn:number|null}", "{handoffId:string}"], "text": "redacted-string|null", "sectioned": "boolean|null", "shapeKey": "lowercase-8-hex|null", "shapeCanonical": "string|null" },
      "privacy": "local-only; compact ref and canonical stripped before render/archive",
      "validation": "validateRefIdentity precedes every ref index insertion",
      "error": "hash mismatch throws before join",
      "positiveControl": "phase-1:A14 matching pair",
      "negativeControl": "phase-1:A14 pipe separator or altered ref",
      "sources": ["decisions.md:D73", "phase-1.md:A14", "phase-2.md:R30"],
      "status": "resolved"
    },
    {
      "id": "validatedIdentityIndexes",
      "producer": "phase-1:R17",
      "consumers": ["phase-2:R30", "phase-3:R1", "phase-4:R3"],
      "schema": { "refSignature": "buildValidatedRefIndex(records):FrozenRefIndex", "refExactKeys": ["size", "has", "get", "entries"], "shapeSignature": "buildValidatedShapeIndex(records):FrozenShapeIndex", "shapeExactKeys": ["size", "collisionGroups", "has", "get", "entries"], "get": "frozen-source-ordered-record-array|undefined", "entries": "new-frozen-array-of-frozen-key-record-array-pairs", "mutableMapExposed": false },
      "privacy": "build-local capabilities; canonical strings and records never rendered or archived",
      "validation": "builders call validateRefIdentity or validateShapeIdentity before indexing",
      "error": "ref mismatch or same-ref/different-canonical throws before result; every distinct canonical group under a colliding shape key contributes one to collisionGroups and all records under that key are excluded from lookup",
      "positiveControl": "phase-1:R17 exact frozen capabilities consumed directly by phases 2-4",
      "negativeControl": "consumer wrapper, mutable Map, ref collision, or collided shape lookup",
      "sources": ["decisions.md:D73", "phase-1.md:R17", "phase-2.md:R30", "phase-3.md:R1", "phase-4.md:R3"],
      "status": "resolved"
    },
    {
      "id": "ensureLaneCorpus",
      "producer": "phase-2:R8",
      "consumers": ["phase-3:R1", "phase-4:R1"],
      "schema": { "signature": "ensureLaneCorpus():LaneCorpus", "exactKeys": ["sessions", "handoffs", "sessionFiles", "identities", "copyRunIndex"], "sessionFiles": "{count:nonnegative-integer,state:present|absent}", "identities": "ReadonlyArray<IdentityRecord>", "copyRunIndex": "ReadonlyMap<lowercase-64-hex-SHA256-of-normalized-four-word-run,positive-integer>" },
      "privacy": "build-local; contains no recoverable corpus source string",
      "validation": "memoized object identity; carrier records consumed unchanged",
      "error": "corpus absent follows D10/D64",
      "positiveControl": "phase-2:A64 complete exact-key result",
      "negativeControl": "phase-2:A64 recursive source-string rejection",
      "sources": ["decisions.md:D73", "decisions.md:D78", "phase-2.md:R8", "phase-2.md:A64"],
      "status": "resolved"
    },
    {
      "id": "assistantTurns",
      "producer": "phase-1:R4",
      "consumers": ["phase-2:R29"],
      "schema": { "type": "Array", "elementExactKeys": ["text"], "text": "redacted-string", "empty": [] },
      "privacy": "no machine envelope or tool-result body",
      "validation": "exact-key structural scan",
      "error": "invalid draft boundary",
      "positiveControl": "phase-1:A13 one redacted text object",
      "negativeControl": "phase-1:A13 extra key or unredacted value",
      "sources": ["decisions.md:D74", "phase-1.md:R4", "phase-1.md:A13"],
      "status": "resolved"
    },
    {
      "id": "renderTranscriptReceipt",
      "producer": "phase-2:R18",
      "consumers": ["phase-3:R9", "phase-4:R4"],
      "schema": { "signature": "renderTranscriptReceipt(receipt,format):string", "format": ["markdown", "html"], "receipt": ["{sessionId:string,turn:number|null}", "{handoffId:string}"], "htmlWrapper": "wl-transcript-receipt" },
      "privacy": "visible source pointer; never styled as git evidence",
      "validation": "exact receipt union and format",
      "error": "throw before rendering",
      "positiveControl": "phase-2:A72 valid escaped handoff receipt",
      "negativeControl": "phase-2:A72 malformed receipt",
      "sources": ["decisions.md:D74", "phase-2.md:R18", "phase-2.md:A72"],
      "status": "resolved"
    },
    {
      "id": "authoredForwardItem",
      "producer": "phase-3:R13",
      "consumers": ["phase-3:R3", "phase-3:R12"],
      "schema": { "requiredExactKeys": ["id", "ref", "text", "origin", "receipt"], "optionalKeys": ["closedBy"], "origin": ["you", "assistant"], "receipt": "{sessionId:string,turn:number|null}", "closedBy": "lowercase-8-hex" },
      "privacy": "authored local input; derived repo/disposition/provenance prohibited",
      "validation": "unknown keys and derived fields rejected",
      "error": "structural row drop; duplicate id aborts",
      "positiveControl": "phase-3:A6 exact five-key row",
      "negativeControl": "phase-3:A11 conflicting derived field",
      "sources": ["decisions.md:D74", "phase-3.md:R3", "phase-3.md:R13"],
      "status": "resolved"
    },
    {
      "id": "deriveCurrentForwardRows",
      "producer": "phase-3:R16",
      "consumers": ["phase-4:R1", "phase-4:A35"],
      "schema": { "signature": "deriveCurrentForwardRows(authoredForwardRows,laneCorpus,config,week,resolveLaneCommit):ForwardDerivation", "exactKeys": ["finalPrivateRows", "engineForwardRows", "laneInputPresence", "diagnostics"], "privateRowRequiredKeys": ["id", "ref", "text", "origin", "receipt", "repo", "disposition", "dispositionAsOf", "sourceKind"], "privateRowOptionalKeys": ["closedBy"], "engineRowExactKeys": ["id", "ref", "text", "origin", "receipt", "repo", "disposition", "dispositionAsOf", "sourceKind"], "engineOrigin": ["handoff-next-step", "handoff-reversal"], "engineReceipt": "{handoffId:string}", "engineSourceKind": "engine", "laneInputPresence": "{authoredForward:boolean,engineForward:boolean}" },
      "privacy": "private boundary; no hidden state",
      "validation": "required-key proxy; no tuple fallback or aliases",
      "error": "reject missing or extra contract keys",
      "positiveControl": "phase-3:A39 named object with engine row",
      "negativeControl": "phase-3:A39 missing/extra result key",
      "sources": ["decisions.md:D74", "phase-3.md:R16", "phase-4.md:R1"],
      "status": "resolved"
    },
    {
      "id": "forwardDiagnostics",
      "producer": "phase-3:R16",
      "consumers": ["phase-4:R1", "build diagnostics"],
      "schema": { "exactKeys": ["commitResolutionFailures", "rowDrops", "nounWarnings", "ideaTruncations"], "commitResolutionFailures": "Array<{rowId:string,state:unresolved|unusable-repo}>", "rowDrops": "Array<{rowId:string,reason:invalid-shape|identity-unresolved|source-conflict}>", "nounWarnings": "Array<{rowId:string,count:positive-integer}>", "ideaTruncations": "Array<{sessionId:string,dropped:positive-integer,firstDroppedTurn:number|null}>" },
      "privacy": "ids, counts, and closed reason codes only",
      "validation": "source order; per-array id deduplication",
      "error": "no second lookup or mutable side channel permitted",
      "positiveControl": "phase-3:A44 all four populated",
      "negativeControl": "phase-3:A44 wrong-author/valid/ambient/zero controls",
      "sources": ["decisions.md:D74", "decisions.md:D79", "phase-3.md:R6", "phase-3.md:A44"],
      "status": "resolved"
    },
    {
      "id": "stdoutAuthority",
      "producer": "phase-2:R23 and phase-3:R16",
      "consumers": ["phase-4:R8"],
      "schema": { "extendedWhen": ["authoredTechniquesNonempty", "laneInputPresence.authoredForward", "laneInputPresence.engineForward"], "finalCounts": ["techniqueRows", "forwardRows"], "legacyOnlyWhenAllRawSourcesAbsent": true },
      "privacy": "counts only",
      "validation": "raw presence captured before drops",
      "error": "final presence cannot override branch",
      "positiveControl": "phase-3:A29b authored row drops but extended stdout remains",
      "negativeControl": "phase-3:A29b empty authored array uses legacy stdout",
      "sources": ["decisions.md:D75", "phase-2.md:R23", "phase-3.md:R10", "phase-4.md:R8"],
      "status": "resolved"
    },
    {
      "id": "forwardMetadataFormatter",
      "producer": "phase-2:R19",
      "consumers": ["phase-3:R9", "phase-4:R7"],
      "schema": { "optionalInputs": ["closedByReceipt", "firstSeenWeek"], "pointerOrder": "after-date-before-row-receipt", "carryDate": "first seen <firstSeenWeek>; as of <dispositionAsOf>", "currentDate": "as of <dispositionAsOf>" },
      "privacy": "public copy; all dynamic values escaped",
      "validation": "Phase 3 supplies resolved receipt only; Phase 4 supplies date only",
      "error": "malformed receipt throws; absent option changes zero bytes",
      "positiveControl": "phase-2:A72 pointer and carry metadata",
      "negativeControl": "phase-2:A72 absent and malformed pointer",
      "sources": ["decisions.md:D77", "phase-2.md:R19", "phase-3.md:R9", "phase-4.md:R7"],
      "status": "resolved"
    },
    {
      "id": "carryIndexRefIdentity",
      "producer": "phase-4:R6",
      "consumers": ["phase-4:R2", "phase-4:R3", "phase-4:R11"],
      "schema": { "property": "refCanonical", "memory": "kind+U+0000+sourceId+U+0000+index", "disk": "JSON string with two literal \\u0000 escapes", "version": 1 },
      "privacy": "engine-written local state only",
      "validation": "JSON.parse then validateRefIdentity before all joins",
      "error": "row mismatch drops loudly; validated collision aborts",
      "positiveControl": "phase-4:A5 round-trip and phase-4:A24b matching pair",
      "negativeControl": "phase-4:A24b mismatched hash/canonical pair",
      "sources": ["decisions.md:D73", "phase-4.md:R2", "phase-4.md:R6", "phase-4.md:R11"],
      "status": "resolved"
    },
    {
      "id": "receiptInvariant",
      "producer": "decisions:D76",
      "consumers": ["phase-2:R26", "phase-3:R11", "phase-4:R4"],
      "schema": { "allEmittedItems": "source-receipt", "gitCheckableWork": "commit-receipt", "privateDisplaySessionOnlyWork": "transcript-receipt-allowed", "laneRows": "transcript-receipt-required" },
      "privacy": "display repo makes zero git calls and carries no SHA",
      "validation": "renderer rejects missing receipt",
      "error": "build error before render",
      "positiveControl": "phase-2:A71 git-checkable work receipt",
      "negativeControl": "phase-2:A71 display/session rows contain no SHA and make no git call",
      "sources": ["decisions.md:D76", "AGENTS.md:invariant-1", "lib/build.mjs:display-guards", "phase-2.md:A71"],
      "status": "resolved"
    }
  ]
}
